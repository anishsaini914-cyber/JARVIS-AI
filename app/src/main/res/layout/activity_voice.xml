<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_overlay">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Wave Animation Placeholder -->
        <ImageView
            android:id="@+id/ivWave"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_jarvis_ai"
            android:scaleType="centerInside"
            android:padding="20dp"
            android:background="@drawable/glass_card_background"
            android:backgroundTint="@color/primary"
            android:elevation="8dp" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_ready"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <!-- Voice Text -->
        <TextView
            android:id="@+id/tvVoiceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:minLines="2" />

        <!-- Response -->
        <TextView
            android:id="@+id/tvResponse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSwitchToChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="@drawable/glass_card_background"
                android:contentDescription="Switch to chat"
                android:padding="12dp"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:background="@drawable/glass_card_background"
                android:backgroundTint="@color/accent"
                android:contentDescription="Microphone"
                android:padding="16dp"
                android:layout_marginHorizontal="24dp"
                app:tint="@color/text_dark" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@drawable/glass_card_background"
                android:contentDescription="Close"
                android:padding="12dp"
                app:tint="@color/error" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
